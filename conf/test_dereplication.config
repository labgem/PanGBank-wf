/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run labgem/pangbank -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/
process {
    resourceLimits = [
        cpus: 2,
        memory: '2.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name = 'Test profile from gbff with dereplication steps'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data

    genomes = 'https://raw.githubusercontent.com/labgem/PanGBank-test-datasets/main/input_files/genome_to_gbff_path.tsv'
    taxonomy = 'https://raw.githubusercontent.com/labgem/PanGBank-test-datasets/main/input_files/genome_to_taxonomy.tsv'
    outdir = "./results/"
    dereplication_threshold = 10
}
