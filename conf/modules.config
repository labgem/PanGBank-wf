/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: PARSE_GENOMES_AND_TAXONOMY {
        publishDir = [
            path: { "${params.outdir}/" },
            mode: params.publish_dir_mode,
            pattern:"species_summary.tsv"
        ]
        publishDir = [
            path: { "${params.outdir}/pangenomes/"},
            mode: params.publish_dir_mode,
            saveAs: { filename -> "${new File(filename).getBaseName()}/input_genomes.tsv" },
            pattern: "ppanggolin_input_files/*.tsv"
        ]
    }

    withName: PPANGGOLIN_ALL {
        publishDir = [
            path: { "${params.outdir}/pangenomes/" },
            mode: params.publish_dir_mode,
            // save yaml info in its pangenome dir. Need the name of the pangenome in the file in GATHER_PANGENOME_INFO process
            saveAs: { filename -> filename.endsWith(".yaml")      ? "${meta.species}/info.yaml" :
                                    filename.equals('versions.yml') ? null : filename }
        ]
    }

    // not sure we should publish fasta seq here
    withName: PPANGGOLIN_FASTA {
        publishDir = [
            path: { "${params.outdir}/pangenomes/" },
            mode: params.publish_dir_mode,
            // save yaml info in its pangenome dir. Need the name of the pangenome in the file in GATHER_PANGENOME_INFO process
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: GATHER_PANGENOME_INFO {
        publishDir = [
            path: { "${params.outdir}/pangenomes/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MD5SUM_ON_FILES {
        publishDir = [
            path: { "${params.outdir}/pangenomes/${meta.species}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MASH_SKETCH {
        ext.args = '-l'
        publishDir = [
            path: { "${params.outdir}/all_persistent_families_mash_sketch" },
            mode: params.publish_dir_mode,
            pattern:"families_persistent_all.msh",
        ]
    }

    withName: MASH_SKETCH_GENOMES {
        ext.args = '-k 18 -s 5000 -l'
        publishDir = [ enabled:false
        ]
    }

    withName: SORT_GENOMES {
        publishDir = [
            path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "sorted_genomes.txt"
        ]
    }
    withName: ANY2FASTA {
        publishDir = [enabled:false
            // path: { "${params.outdir}/genome_dereplication/fasta_files" },
            // mode: params.publish_dir_mode,
            // saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SEQFU_STATS_FROM_FILE {
        publishDir = [
            path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MASH_DIST_TO_PHYLIP {
        publishDir = [enabled:false
            // path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            // mode: params.publish_dir_mode,
            // saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: QUICKTREE {
        publishDir = [enabled:false
            // path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            // mode: params.publish_dir_mode,
            // saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GENOME_SELECTION_FROM_TREE {
        publishDir = [
            path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern : "selected_genomes.txt"
        ]
    }

    withName: FORMAT_INPUT_GENOMES {
        publishDir = [
            path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern : "summary_selection.tsv"
        ]
        publishDir = [
            path: { "${params.outdir}/pangenomes/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern : "formatted_selected_genomes.tsv",
            saveAs : {"dereplicated_input_genomes.tsv"}
        ]
    }

    withName: CLUSTER_STAT {
        memory = { 12.GB * (task.attempt ** 2) }
        publishDir = [
            path: { "${params.outdir}/genome_dereplication/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CLUSTER_PLOT {
        publishDir = [
            path: { "${params.outdir}/genome_dereplication/" },
            mode: params.publish_dir_mode,
            pattern : "plots/*html",
        ]
    }



    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }



}
